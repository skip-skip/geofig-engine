# Copy this file to .env and fill in your API tokens.
# .env is gitignored and excluded from source distributions. Never commit it.
#
# TestPyPI token: https://test.pypi.org/manage/account/token/
# PyPI token:     https://pypi.org/manage/account/token/
#
# The tokens are different; create one for each index you plan to use.

TEST_PYPI_API_TOKEN=
PYPI_API_TOKEN=
